# ─────────────────────────────────────────────────────────────
# Twaky configuration (copy to .env and adjust)
# ─────────────────────────────────────────────────────────────
# All secrets should be generated locally. Examples:
#   openssl rand -hex 32     # good for NEXTAUTH_SECRET, ENCRYPTION_KEY
#   openssl rand -base64 24  # good for passwords
# ─────────────────────────────────────────────────────────────

# --- Domain (also read by the platform's root .env) ---
BASE_DOMAIN=twake-dev.maudet.cloud

# --- Twaky Postgres+AGE (dedicated instance, no host port) ---
TWAKY_PG_HOST=twaky-pg
TWAKY_PG_PORT=5432
TWAKY_PG_DB=twaky
TWAKY_PG_USER=twaky
TWAKY_PG_PASSWORD=change-me-openssl-rand-base64-24
TWAKY_GRAPH_NAME=twake

# --- Langfuse Postgres (same twaky-pg instance, separate DB/user) ---
LANGFUSE_PG_DB=langfuse
LANGFUSE_PG_USER=langfuse
LANGFUSE_PG_PASSWORD=change-me-openssl-rand-base64-24

# --- Owner scoping (REQUIRED — instance refuses to start without it) ---
TWAKY_OWNER_EMAIL=you@twake-dev.maudet.cloud

# --- RabbitMQ (shared, on twake-network) ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F

# --- Ingest scope (fanout exchanges to bind, comma-separated) ---
AGENT_EXCHANGES=calendar:event:created,calendar:event:updated,calendar:event:request,calendar:event:deleted,calendar:event:cancel,calendar:event:reply,sabre:contact:created,sabre:contact:updated,sabre:contact:update,sabre:contact:deleted,mail:message:received,mail:message:expunged,mail:message:flags:updated,mail:message:moved
AGENT_QUEUE=agent.graph.ingest
AGENT_PREFETCH=32

# --- LLM abstraction (LiteLLM) ---
# Pick ONE provider by setting the model + relevant *_API_KEY.
# See https://docs.litellm.ai/docs/providers for the model naming.
#
# Verified working (T5+T7): OpenRouter → Moonshot Kimi K2
MODEL=openrouter/moonshotai/kimi-k2-0905
OPENROUTER_API_KEY=
#
# Other verified providers:
# MODEL=claude-sonnet-4-5-20250929
# ANTHROPIC_API_KEY=
#
# MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=
#
# MODEL=hosted_vllm/qwen2.5:14b     # self-hosted vLLM/Ollama
# LITELLM_API_BASE=http://vllm.local:8000/v1

# --- Langfuse (self-hosted, obtained from UI after first boot) ---
LANGFUSE_HOST=http://twaky-langfuse-web:3000
LANGFUSE_PROJECT_ID=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Public URL for browser access; used in trace URLs logged to CLI
LANGFUSE_PUBLIC_URL=https://langfuse.${BASE_DOMAIN}

# --- Langfuse server-side secrets (never exposed to user) ---
NEXTAUTH_SECRET=change-me-openssl-rand-hex-32
SALT=change-me-openssl-rand-hex-32
ENCRYPTION_KEY=change-me-openssl-rand-hex-32
CLICKHOUSE_PASSWORD=change-me-openssl-rand-base64-24
REDIS_AUTH=change-me-openssl-rand-base64-24
S3_ACCESS_KEY=twakylangfuseaccess
S3_SECRET_KEY=change-me-openssl-rand-base64-24
LANGFUSE_INIT_ORG_ID=twaky-org
LANGFUSE_INIT_ORG_NAME=Twaky
LANGFUSE_INIT_PROJECT_ID=twaky-project
LANGFUSE_INIT_PROJECT_NAME=twaky
LANGFUSE_INIT_USER_EMAIL=admin@twake-dev.maudet.cloud
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=change-me

# --- SSO via LemonLDAP-NG OIDC (empty = local email/password login only) ---
AUTH_CUSTOM_NAME=LemonLDAP
AUTH_CUSTOM_CLIENT_ID=
AUTH_CUSTOM_CLIENT_SECRET=
AUTH_CUSTOM_ISSUER=https://auth.${BASE_DOMAIN}/
AUTH_CUSTOM_SCOPE="openid email profile"
AUTH_CUSTOM_CLIENT_AUTH_METHOD=client_secret_basic
AUTH_CUSTOM_ID_TOKEN=true
AUTH_CUSTOM_ALLOW_ACCOUNT_LINKING=true

# --- Metabase (BI on top of ClickHouse via twaky-pg for its own metadata) ---
METABASE_PG_DB=metabase
METABASE_PG_USER=metabase
METABASE_PG_PASSWORD=change-me-openssl-rand-base64-24

# --- Sub-agent LLMs (leave empty to fall back to MODEL above) ---
ATLAS_MODEL=
CHRONOS_MODEL=
PLUME_MODEL=
IRIS_MODEL=

# --- Atlas daemon limits ---
TWAKY_ATLAS_MAX_CONCURRENT_MISSIONS=4
TWAKY_ATLAS_MAX_STEPS=12
TWAKY_ATLAS_MISSION_TIMEOUT_S=300
TWAKY_ATLAS_MAX_TOKENS=100000

# --- External services (defaults resolve on twake-network) ---
JMAP_ENDPOINT=http://tmail-backend:8080/jmap
SEARXNG_ENDPOINT=http://searxng:8080

# --- Plume OIDC token exchange (mimics Twake Visio ↔ Calendar) ---
PLUME_OIDC_CLIENT_ID=twaky-plume
PLUME_OIDC_CLIENT_SECRET=
PLUME_OIDC_ISSUER=https://auth.${BASE_DOMAIN}/

# --- Sub-project 3a: API ---
API_BASE_URL=https://twaky.twake-dev.maudet.cloud
API_SESSION_SECRET=  # generate: openssl rand -hex 32
API_OIDC_CLIENT_ID=twaky-api
API_OIDC_CLIENT_SECRET=
API_OIDC_ISSUER=https://auth.twake-dev.maudet.cloud/

# --- Sentinels ---
SENTINEL_TIMEOUT_S=60
SENTINEL_MAX_CONCURRENT_EVENTS=4
SENTINEL_RUN_RETENTION_DAYS=30

# JMAP polling (mail-sentinel via jmap_poll event source)
JMAP_SESSION_URL=
JMAP_BEARER_TOKEN=
JMAP_ACCOUNT_EMAIL=
JMAP_POLL_INTERVAL_S=60

# LLM tiers for mail-sentinel
MAIL_SENTINEL_ECONOMY_LLMS=openrouter/moonshotai/kimi-k2
MAIL_SENTINEL_DEFAULT_LLMS=openrouter/moonshotai/kimi-k2
MAIL_SENTINEL_CHAT_LLMS=openrouter/moonshotai/kimi-k2
MAIL_SENTINEL_DRAFT_LLMS=openrouter/moonshotai/kimi-k2
